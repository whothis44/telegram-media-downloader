{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whothis44/telegram-media-downloader/docs/archive-data-sample/schema.json",
  "title": "Telegram archive data export, format version 4",
  "description": "One JSON object per line in each .jsonl file. Use the $defs entry named after the file: manifest.json → manifest, groups.jsonl → group, messages/*.jsonl.gz → message, files.jsonl → file, peers.jsonl → peer, topics.jsonl → topic, near_duplicates.jsonl → nearDuplicateSet, posts.jsonl → post, families.jsonl → family, sets.jsonl → mediaSet, media_clusters.jsonl → mediaCluster, covered.jsonl → covered, entities.jsonl → entity. manifest-sha256.txt is plain text: '<sha256>  <path>' per line.",
  "$defs": {
    "groupId": {
      "type": "string",
      "pattern": "^-?[0-9]+$",
      "description": "The downloader's marked chat ID. Channels and supergroups: -100 followed by chat_id; basic groups: minus chat_id."
    },
    "chatId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Telegram's own chat ID."
    },
    "peerId": {
      "type": "string",
      "pattern": "^(user|channel|chat):[0-9]+$",
      "description": "A sender or source; names are in peers.jsonl."
    },
    "telegramFile": {
      "type": "string",
      "pattern": "^(photo|document):-?[0-9]+:[0-9]+$",
      "description": "kind:id:size of the file on Telegram. Equal values are the same upload (for example one video forwarded to several chats)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unixSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "unixMillis": {
      "type": "integer",
      "minimum": 0
    },
    "manifest": {
      "type": "object",
      "required": [
        "format",
        "format_version",
        "exported_at",
        "app_version",
        "downloads_root",
        "groups",
        "files"
      ],
      "properties": {
        "format": {
          "const": "telegram-archive"
        },
        "format_version": {
          "const": 4
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "app_version": {
          "type": "string"
        },
        "downloads_root": {
          "type": "string",
          "description": "The downloads folder as the server saw it; file paths are relative to it."
        },
        "groups": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "chat_id",
        "name",
        "configured",
        "download_settings",
        "messages",
        "files",
        "messages_file"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/groupId"
        },
        "chat_id": {
          "$ref": "#/$defs/chatId"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "description": "The user's own grouping of related chats."
        },
        "configured": {
          "type": "boolean",
          "description": "In the downloader's list of chats (false: known only from old files or messages)."
        },
        "download_settings": {
          "type": "object",
          "description": "Which kinds of media are downloaded for this chat.",
          "additionalProperties": true
        },
        "messages": {
          "type": "integer",
          "minimum": 0,
          "description": "Lines in messages_file."
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "last_full_rescan": {
          "$ref": "#/$defs/unixMillis"
        },
        "messages_file": {
          "type": "string",
          "pattern": "^messages/g_[0-9A-Za-z_]+\\.jsonl\\.gz$"
        },
        "telegram_title": {
          "type": "string"
        },
        "about": {
          "type": "string",
          "description": "The chat's description on Telegram."
        },
        "username": {
          "type": "string"
        },
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "pinned_message_id": {
          "type": "integer"
        },
        "discussion_group_id": {
          "$ref": "#/$defs/groupId",
          "description": "A channel's discussion group: the comments on its posts are that group's messages."
        },
        "telegram_message_count": {
          "type": "integer",
          "minimum": 0,
          "description": "How many messages Telegram said the chat holds at the last rescan; compare with messages for completeness."
        },
        "telegram_message_count_at": {
          "$ref": "#/$defs/unixMillis"
        },
        "finished_at": {
          "$ref": "#/$defs/unixMillis",
          "description": "Marked finished: rescans leave the chat alone."
        },
        "info_tl_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "messages.chatFull as Telegram sent it."
        },
        "type": {
          "enum": [
            "channel",
            "supergroup",
            "forum",
            "group"
          ]
        },
        "forum": {
          "type": "boolean"
        },
        "link": {
          "type": "string",
          "description": "Public link (https://t.me/<username>)."
        },
        "invite_link": {
          "type": "string",
          "description": "An invite link, when Telegram gave one (the account made it or administers the chat)."
        },
        "photo": {
          "type": "string",
          "description": "The chat's picture, relative to the data folder (photos/...)."
        },
        "message_ids_gone": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(-[0-9]+)?$"
          },
          "description": "Message numbers Telegram confirmed are gone, as single numbers or ranges."
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "download_id",
        "path",
        "size"
      ],
      "description": "A downloaded file. In files.jsonl it also has group_id.",
      "properties": {
        "group_id": {
          "$ref": "#/$defs/groupId"
        },
        "download_id": {
          "type": "integer"
        },
        "path": {
          "type": "string",
          "description": "Relative to the manifest's downloads_root, '/' separated. Several records can share one path: identical files are stored once."
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "examples": [
            "photo",
            "video",
            "document",
            "audio"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "telegram_file": {
          "$ref": "#/$defs/telegramFile"
        },
        "created_at": {
          "type": "string",
          "description": "When it was downloaded, UTC, \"YYYY-MM-DD HH:MM:SS\"."
        },
        "mime": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "thumb_stripped_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Telegram's tiny stripped preview: a JPEG body without its standard header (core.telegram.org/api/files#stripped-thumbnails)."
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "group_id",
        "chat_id",
        "message_id",
        "date",
        "text",
        "media",
        "file_status",
        "files",
        "first_seen",
        "last_seen"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/groupId"
        },
        "chat_id": {
          "$ref": "#/$defs/chatId"
        },
        "message_id": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "$ref": "#/$defs/unixSeconds",
          "description": "0 for a stub (a downloaded file whose message was never captured)."
        },
        "date_utc": {
          "type": "string",
          "format": "date-time"
        },
        "edit_date": {
          "$ref": "#/$defs/unixSeconds"
        },
        "text": {
          "type": "string",
          "description": "Plain text or caption; formatting is in raw.entities."
        },
        "album_id": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "Telegram grouped_id: messages of one chat sharing it form one album."
        },
        "sender": {
          "$ref": "#/$defs/peerId"
        },
        "post_author": {
          "type": "string",
          "description": "Signature on a channel post."
        },
        "forwarded_from": {
          "type": "string",
          "description": "A peer_id, a plain name, or \"hidden\"."
        },
        "forwarded_date": {
          "$ref": "#/$defs/unixSeconds"
        },
        "reply_to": {
          "type": "integer",
          "description": "message_id in the same chat."
        },
        "topic_id": {
          "type": "integer",
          "description": "Forum topic (topics.jsonl). Absent in a forum means General (1)."
        },
        "views": {
          "type": "integer",
          "minimum": 0
        },
        "media": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "examples": [
                    "photo",
                    "video",
                    "document",
                    "audio",
                    "voice",
                    "gif",
                    "sticker",
                    "unknown"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "telegram_file": {
                  "$ref": "#/$defs/telegramFile"
                },
                "mime": {
                  "type": "string"
                },
                "width": {
                  "type": "integer",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_s": {
                  "type": "number",
                  "minimum": 0
                },
                "thumb_stripped_base64": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "description": "Telegram's tiny stripped preview: a JPEG body without its standard header (core.telegram.org/api/files#stripped-thumbnails)."
                }
              }
            }
          ]
        },
        "file_status": {
          "enum": [
            "downloaded",
            "missing",
            "not_wanted",
            "no_media"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "edits": {
          "type": "array",
          "description": "Earlier versions of the text, oldest first.",
          "items": {
            "type": "object",
            "required": [
              "edit_date",
              "text",
              "recorded_at"
            ],
            "properties": {
              "edit_date": {
                "$ref": "#/$defs/unixSeconds"
              },
              "text": {
                "type": "string"
              },
              "recorded_at": {
                "$ref": "#/$defs/unixMillis"
              }
            }
          }
        },
        "deleted_at": {
          "$ref": "#/$defs/unixMillis",
          "description": "When a full rescan no longer found it on Telegram."
        },
        "first_seen": {
          "$ref": "#/$defs/unixMillis"
        },
        "last_seen": {
          "$ref": "#/$defs/unixMillis"
        },
        "raw": {
          "type": "object",
          "required": [
            "_"
          ],
          "description": "The complete Telegram message (or system notice), decoded: every object has \"_\" (its TL constructor) and snake_case fields; bytes are base64; fields that are 0, false or empty are left out.",
          "properties": {
            "_": {
              "enum": [
                "message",
                "messageService"
              ]
            }
          },
          "additionalProperties": true
        },
        "tl_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "The original TL serialisation of the message."
        },
        "service": {
          "type": "string",
          "pattern": "^messageAction",
          "description": "Set on system notices (pin, title change, topic created...): the TL action. text describes it."
        },
        "comments": {
          "type": "integer",
          "minimum": 0,
          "description": "On a channel post: how many comments Telegram reports."
        },
        "comment_on": {
          "type": "object",
          "required": [
            "group_id",
            "message_id"
          ],
          "description": "On a comment: the channel post it belongs to.",
          "properties": {
            "group_id": {
              "$ref": "#/$defs/groupId"
            },
            "message_id": {
              "type": "integer"
            }
          }
        }
      }
    },
    "peer": {
      "type": "object",
      "required": [
        "peer_id",
        "kind",
        "name",
        "updated_at"
      ],
      "properties": {
        "peer_id": {
          "$ref": "#/$defs/peerId"
        },
        "kind": {
          "enum": [
            "user",
            "channel",
            "chat"
          ]
        },
        "name": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/unixMillis"
        }
      }
    },
    "topic": {
      "type": "object",
      "required": [
        "group_id",
        "topic_id",
        "title"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/groupId"
        },
        "topic_id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "nearDuplicateSet": {
      "type": "object",
      "required": [
        "cluster",
        "kind",
        "members",
        "pairs"
      ],
      "properties": {
        "cluster": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "same",
            "mixed"
          ],
          "description": "same: every member is the same video; mixed: some are clips of others."
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "description": "Largest file first.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "size",
              "duration_s",
              "places"
            ],
            "properties": {
              "download_id": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "duration_s": {
                "type": "number",
                "minimum": 0
              },
              "places": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "group_id",
                    "message_id"
                  ],
                  "properties": {
                    "group_id": {
                      "$ref": "#/$defs/groupId"
                    },
                    "message_id": {
                      "type": "integer"
                    }
                  }
                }
              },
              "telegram_file": {
                "$ref": "#/$defs/telegramFile"
              }
            }
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "a",
              "b",
              "kind",
              "score",
              "offset_s"
            ],
            "properties": {
              "a": {
                "type": "integer",
                "minimum": 0,
                "description": "Index into members."
              },
              "b": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "same",
                  "clip",
                  "overlap"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "offset_s": {
                "type": "number",
                "description": "Where the clip starts inside the longer video, in seconds."
              },
              "cover_a": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cover_b": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "postFile": {
      "type": "object",
      "required": [
        "message_id",
        "cluster",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "type": "integer"
        },
        "cluster": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "subst",
            "held",
            "missing"
          ],
          "description": "ok: downloaded; subst: not downloaded, the same bytes are saved (see covered.jsonl); held: a probable copy waiting at the back of the queue; missing: not downloaded"
        }
      }
    },
    "postRef": {
      "type": "string",
      "pattern": "^-?[0-9]+:[0-9]+$",
      "description": "<group_id>:<first message_id>"
    },
    "post": {
      "type": "object",
      "required": [
        "post",
        "group_id",
        "message_ids",
        "date",
        "family",
        "role",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "post": {
          "$ref": "#/$defs/postRef"
        },
        "group_id": {
          "$ref": "#/$defs/groupId"
        },
        "message_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "album_id": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/unixSeconds"
        },
        "original_date": {
          "$ref": "#/$defs/unixSeconds"
        },
        "family": {
          "type": "integer"
        },
        "role": {
          "enum": [
            "original",
            "repost",
            "adds"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postFile"
          }
        }
      }
    },
    "family": {
      "type": "object",
      "required": [
        "family",
        "lead_post",
        "first_date",
        "chats",
        "posts",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "integer"
        },
        "lead_post": {
          "$ref": "#/$defs/postRef"
        },
        "first_date": {
          "$ref": "#/$defs/unixSeconds"
        },
        "chats": {
          "type": "integer"
        },
        "merged": {
          "type": "boolean"
        },
        "posts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "post",
              "group_id",
              "date",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "post": {
                "$ref": "#/$defs/postRef"
              },
              "group_id": {
                "$ref": "#/$defs/groupId"
              },
              "date": {
                "$ref": "#/$defs/unixSeconds"
              },
              "role": {
                "enum": [
                  "original",
                  "repost",
                  "adds"
                ]
              }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cluster",
              "best",
              "introduced_by"
            ],
            "additionalProperties": false,
            "properties": {
              "cluster": {
                "type": "integer"
              },
              "best": {
                "$ref": "#/$defs/postFile"
              },
              "introduced_by": {
                "$ref": "#/$defs/postRef"
              }
            }
          }
        }
      }
    },
    "mediaSet": {
      "type": "object",
      "description": "Posts (families) by different people or chats that share some pictures or videos although none holds them all.",
      "required": [
        "set",
        "anchor_post",
        "first_date",
        "last_date",
        "chats",
        "families",
        "posts",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "integer"
        },
        "anchor_post": {
          "$ref": "#/$defs/postRef",
          "description": "The set's first post: the same set across exports."
        },
        "first_date": {
          "$ref": "#/$defs/unixSeconds"
        },
        "last_date": {
          "$ref": "#/$defs/unixSeconds"
        },
        "chats": {
          "type": "integer",
          "minimum": 1
        },
        "families": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2
        },
        "posts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postRef"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cluster",
              "best",
              "role",
              "in_families"
            ],
            "additionalProperties": false,
            "properties": {
              "cluster": {
                "type": "integer"
              },
              "best": {
                "$ref": "#/$defs/postFile"
              },
              "role": {
                "enum": [
                  "core",
                  "member",
                  "loose",
                  "elsewhere"
                ],
                "description": "core: in two or more of its families; member: in one; loose: in one but unlike the core (image recognition); elsewhere: belongs to other_set."
              },
              "in_families": {
                "type": "integer",
                "minimum": 0
              },
              "likeness": {
                "type": "number",
                "description": "Cosine to the closest core file (image recognition); absent when not compared."
              },
              "other_set": {
                "type": "integer"
              },
              "placed_by_person": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "mediaCluster": {
      "type": "object",
      "required": [
        "cluster",
        "kind",
        "best",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "photo",
            "video",
            "other"
          ]
        },
        "generic": {
          "type": "boolean"
        },
        "best": {
          "$ref": "#/$defs/postFile"
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "group_id",
              "message_id",
              "status",
              "matched_by"
            ],
            "additionalProperties": false,
            "properties": {
              "group_id": {
                "$ref": "#/$defs/groupId"
              },
              "message_id": {
                "type": "integer"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "ok",
